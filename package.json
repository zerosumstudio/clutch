{
	"name": "@zerosumstudio/clutch",
	"version": "3.5.0",
	"description": "A TypeScript-first, plugin-based state manager built on Immer",
	"keywords": [
		"state-management",
		"immer",
		"react",
		"typescript",
		"undo-redo",
		"persistence",
		"immutable",
		"redux-alternative"
	],
	"homepage": "https://github.com/zerosumstudio/clutch#readme",
	"bugs": {
		"url": "https://github.com/zerosumstudio/clutch/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/zerosumstudio/clutch.git"
	},
	"license": "MIT",
	"author": "zerosum studio <hello@zerosum.studio>",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./react": {
			"import": {
				"types": "./dist/react.d.ts",
				"default": "./dist/react.js"
			},
			"require": {
				"types": "./dist/react.d.cts",
				"default": "./dist/react.cjs"
			}
		},
		"./sync-ws": {
			"import": {
				"types": "./dist/sync-ws.d.ts",
				"default": "./dist/sync-ws.js"
			},
			"require": {
				"types": "./dist/sync-ws.d.cts",
				"default": "./dist/sync-ws.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepublishOnly": "pnpm run verify",
		"size": "size-limit",
		"test": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:run": "vitest run",
		"test:ui": "vitest --ui",
		"type-check": "tsc --noEmit",
		"verify": "pnpm run type-check && pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run build && pnpm run size"
	},
	"dependencies": {
		"immer": "^11.1.16",
		"use-sync-external-store": "^1.6.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@size-limit/preset-small-lib": "^13.0.3",
		"@testing-library/react": "^16.3.2",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@types/use-sync-external-store": "^1.5.0",
		"@vitest/coverage-v8": "^4.1.10",
		"@vitest/ui": "^4.1.10",
		"eslint": "^10.8.1",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.9.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"size-limit": "^13.0.3",
		"terser": "^5.49.2",
		"tsup": "^8.5.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"react": ">=16.8.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		}
	},
	"packageManager": "pnpm@11.6.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"size-limit": [
		{
			"name": "Core only",
			"path": "dist/index.js",
			"import": "{ createMachine }",
			"limit": "6 KB"
		},
		{
			"name": "React hooks",
			"path": "dist/react.js",
			"limit": "3 KB"
		},
		{
			"name": "Sync WS",
			"path": "dist/sync-ws.js",
			"limit": "4 KB"
		},
		{
			"name": "Full bundle",
			"path": "dist/index.js",
			"limit": "15 KB"
		}
	]
}
