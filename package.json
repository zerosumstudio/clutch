{
	"name": "@zerosumstudio/clutch",
	"version": "1.0.0",
	"description": "A TypeScript-first, plugin-based state store with optional Immer support",
	"keywords": [
		"state-management",
		"immer",
		"react",
		"typescript",
		"undo-redo",
		"persistence",
		"immutable",
		"redux-alternative"
	],
	"homepage": "https://github.com/zerosumstudio/clutch#readme",
	"bugs": {
		"url": "https://github.com/zerosumstudio/clutch/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/zerosumstudio/clutch.git"
	},
	"license": "MIT",
	"author": "zerosum studio <hello@zerosum.studio>",
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"default": "./dist/react.js"
		},
		"./immer": {
			"types": "./dist/immer.d.ts",
			"default": "./dist/immer.js"
		},
		"./sync-ws": {
			"types": "./dist/sync-ws.d.ts",
			"default": "./dist/sync-ws.js"
		},
		"./package.json": "./package.json"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs/sync-protocol.md",
		"docs/migration-1.0.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepublishOnly": "pnpm run verify",
		"size": "size-limit",
		"smoke": "node scripts/smoke.mjs",
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"test:ui": "vitest --ui",
		"type-check": "tsc --noEmit",
		"verify": "pnpm run type-check && pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run build && pnpm run size && pnpm run smoke"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@size-limit/preset-small-lib": "^14.3.0",
		"@testing-library/react": "^16.3.3",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^5.1.1",
		"@vitest/ui": "^5.1.1",
		"eslint": "^10.15.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^17.14.0",
		"immer": "^11.2.10",
		"jsdom": "^31.0.1",
		"prettier": "^3.10.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"size-limit": "^14.3.0",
		"tsdown": "^0.23.7",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vitest": "^5.1.1"
	},
	"peerDependencies": {
		"immer": "^11.1.16",
		"react": ">=18.0.0"
	},
	"peerDependenciesMeta": {
		"immer": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"packageManager": "pnpm@11.6.0",
	"engines": {
		"node": ">=26"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"size-limit": [
		{
			"name": "Core only",
			"path": "dist/index.js",
			"import": "{ createStore }",
			"limit": "2.2 KB"
		},
		{
			"name": "Core + immer",
			"path": [
				"dist/index.js",
				"dist/immer.js"
			],
			"import": {
				"dist/index.js": "{ createStore }",
				"dist/immer.js": "{ immer }"
			},
			"limit": "2.5 KB"
		},
		{
			"name": "immer (peer, informational only)",
			"path": "node_modules/immer/dist/immer.mjs",
			"import": "{ produce, enablePatches }",
			"limit": "5 KB"
		},
		{
			"name": "React hooks",
			"path": "dist/react.js",
			"limit": "1.6 KB"
		},
		{
			"name": "Sync WS",
			"path": "dist/sync-ws.js",
			"limit": "1.4 KB"
		},
		{
			"name": "Main entry (everything)",
			"path": "dist/index.js",
			"limit": "8.5 KB"
		}
	]
}
